# MessMate AI - Backend Environment Configuration

PROJECT_NAME="MessMate AI API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://messmate_user:messmate_password@localhost:5432/messmate_db"
# Fallback for local rapid development without Postgres installed:
# DATABASE_URL="sqlite:///./messmate_dev.db"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_PATH="" # Path to serviceAccountKey.json

# Security
SECRET_KEY="messmate-development-secret-key-change-in-production"
